{
  "browser": {
    "mode": "launch",
    "executable_path": "/home/codespace/.cache/ms-playwright/chromium-1228/chrome-linux64/chrome",
    "headless": true
  },
  "start_url": { "url": "https://typst.app/signin/" },
  "environment": {
    "service_workers": "allow",
    "viewport": { "width": 1440, "height": 960, "device_scale_factor": 1 }
  },
  "secrets": [
    { "secret_id": "typst_email", "environment_variable": "TYPST_EMAIL" },
    { "secret_id": "typst_password", "environment_variable": "TYPST_PASSWORD" }
  ],
  "actions": [
    {
      "step_id": "email-ready",
      "action": "wait_for",
      "locator": { "kind": "css", "selector": "#email" },
      "state": "visible",
      "timeout_ms": 30000
    },
    {
      "step_id": "fill-email",
      "action": "fill",
      "locator": { "kind": "css", "selector": "#email" },
      "value": { "source": "secret", "secret_id": "typst_email" }
    },
    {
      "step_id": "fill-password",
      "action": "fill",
      "locator": { "kind": "css", "selector": "#password" },
      "value": { "source": "secret", "secret_id": "typst_password" }
    },
    {
      "step_id": "submit-signin",
      "action": "click",
      "locator": { "kind": "css", "selector": "input[type=submit]" },
      "timeout_ms": 30000
    },
    { "step_id": "post-signin-settle", "action": "wait_for_timeout", "duration_ms": 12000 },
    {
      "step_id": "open-app",
      "action": "goto",
      "destination": { "url": "https://typst.app/app/" },
      "wait_until": "load",
      "timeout_ms": 60000
    },
    { "step_id": "app-settle", "action": "wait_for_timeout", "duration_ms": 15000 }
  ],
  "capture": {
    "after_each_step": ["accessibility", "url"],
    "at_end": ["dom", "accessibility", "url", "screenshot", "storage"],
    "events": ["console", "page-errors", "network"]
  }
}
