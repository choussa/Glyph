{
  "browser": {
    "mode": "launch",
    "executable_path": "/home/codespace/.cache/ms-playwright/chromium-1228/chrome-linux64/chrome",
    "headless": true
  },
  "start_url": { "url": "https://typst.app/signin/" },
  "environment": {
    "service_workers": "allow",
    "viewport": { "width": 1600, "height": 1000, "device_scale_factor": 1 }
  },
  "secrets": [
    { "secret_id": "typst_email", "environment_variable": "TYPST_EMAIL" },
    { "secret_id": "typst_password", "environment_variable": "TYPST_PASSWORD" }
  ],
  "actions": [
    { "step_id": "email-ready", "action": "wait_for", "locator": { "kind": "css", "selector": "#email" }, "state": "visible", "timeout_ms": 30000 },
    { "step_id": "fill-email", "action": "fill", "locator": { "kind": "css", "selector": "#email" }, "value": { "source": "secret", "secret_id": "typst_email" } },
    { "step_id": "fill-password", "action": "fill", "locator": { "kind": "css", "selector": "#password" }, "value": { "source": "secret", "secret_id": "typst_password" } },
    { "step_id": "submit-signin", "action": "click", "locator": { "kind": "css", "selector": "input[type=submit]" }, "timeout_ms": 30000 },
    { "step_id": "post-signin-settle", "action": "wait_for_timeout", "duration_ms": 10000 },
    { "step_id": "goto-project", "action": "goto", "destination": { "url": "https://typst.app/project/pzqvuEYTS5Z8rJgKMNwYpH" }, "wait_until": "load", "timeout_ms": 60000 },
    { "step_id": "editor-settle", "action": "wait_for_timeout", "duration_ms": 22000 },
    { "step_id": "open-file-menu", "action": "click", "locator": { "kind": "role", "role": "button", "name": "File" }, "timeout_ms": 15000 },
    { "step_id": "file-menu-shown", "action": "wait_for_timeout", "duration_ms": 2500 },
    { "step_id": "close-file-menu", "action": "press", "locator": { "kind": "css", "selector": ".cm-content" }, "key": "Escape" },
    { "step_id": "open-edit-menu", "action": "click", "locator": { "kind": "role", "role": "button", "name": "Edit" }, "timeout_ms": 15000 },
    { "step_id": "edit-menu-shown", "action": "wait_for_timeout", "duration_ms": 2500 },
    { "step_id": "close-edit-menu", "action": "press", "locator": { "kind": "css", "selector": ".cm-content" }, "key": "Escape" },
    { "step_id": "open-view-menu", "action": "click", "locator": { "kind": "role", "role": "button", "name": "View" }, "timeout_ms": 15000 },
    { "step_id": "view-menu-shown", "action": "wait_for_timeout", "duration_ms": 2500 },
    { "step_id": "close-view-menu", "action": "press", "locator": { "kind": "css", "selector": ".cm-content" }, "key": "Escape" },
    { "step_id": "open-share", "action": "click", "locator": { "kind": "role", "role": "button", "name": "Share" }, "timeout_ms": 15000 },
    { "step_id": "share-shown", "action": "wait_for_timeout", "duration_ms": 4000 },
    { "step_id": "close-share", "action": "press", "locator": { "kind": "css", "selector": ".cm-content" }, "key": "Escape" },
    { "step_id": "open-explore", "action": "click", "locator": { "kind": "role", "role": "button", "name": "Explore files" }, "timeout_ms": 15000 },
    { "step_id": "explore-shown", "action": "wait_for_timeout", "duration_ms": 3000 },
    { "step_id": "open-outline", "action": "click", "locator": { "kind": "role", "role": "button", "name": "Show outline" }, "timeout_ms": 15000 },
    { "step_id": "outline-shown", "action": "wait_for_timeout", "duration_ms": 3000 }
  ],
  "capture": {
    "after_each_step": ["accessibility", "url"],
    "at_end": ["dom", "url", "screenshot"],
    "events": ["console", "page-errors", "network"],
    "network": { "request_body": true, "response_body": true, "header_values": true }
  }
}
